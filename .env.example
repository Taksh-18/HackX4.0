# Optional. If omitted, the app uses ./data/disaster.db.
DISASTER_DB_PATH=./data/disaster.db
CDIS_OFFLINE_GEOCODE=1

# Choose one provider. The extraction module detects Groq keys automatically.
GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional overrides for another OpenAI-compatible provider.
# EXTRACTION_BASE_URL=https://provider.example.com/v1
# EXTRACTION_MODEL=provider-model-name
